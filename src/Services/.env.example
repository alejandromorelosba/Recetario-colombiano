# Cadena de conexion de PostgreSQL/Supabase (NUNCA subir el valor real al repositorio)
DATABASE_URL=
# Puerto local de la API (en Render lo asigna la plataforma)
PORT=3000
# Dominios del frontend permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:1234
# Clave para los endpoints administrativos /usuarios (si se omite, quedan deshabilitados)
ADMIN_API_KEY=
